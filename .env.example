# Copia este archivo a .env.local y completa los valores. NUNCA commitear .env.local.
# Desarrollo local: valores de `pnpm exec supabase status` (ver README, "Variables de entorno").
# Nube (staging/prod): solo el dueño, en su propio .env.local.
# Públicas (protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor / scripts. Jamás con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=          # staging en local/CI de pruebas; prod solo en CI de despliegue

# Mapa (HU-PAN-CLI-06, SG-09): OpenFreeMap, sin cuenta ni clave. Vacío = su estilo «liberty».
# Solo para alojar el estilo propio (plan B): su URL y la atribución que pida.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Entrar con Google (ronda 34, #41): «on» cuando Google ya está configurado en Supabase (DEPLOYMENT §5.6).
NEXT_PUBLIC_GOOGLE_SIGN_IN=
