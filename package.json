{
  "name": "colportor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --coverage && vitest run --project storybook",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "user:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "catalog:load": "node --env-file-if-exists=.env.local --import tsx scripts/load-catalog.ts",
    "check:cloud": "node --env-file-if-exists=.env.local --import tsx scripts/check-cloud.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/adapters/supabase/database.types.ts && prettier --write src/adapters/supabase/database.types.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@serwist/turbopack": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/query-async-storage-persister": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "fuse.js": "7.5.0",
    "idb-keyval": "6.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.73.0",
    "maplibre-gl": "5.20.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "playwright": "1.65.1",
    "prettier": "3.9.10",
    "serwist": "9.5.13",
    "storybook": "10.6.7",
    "stylelint": "18.0.0",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
